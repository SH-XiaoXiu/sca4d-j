{
  "name": "@sca4d/admin-common",
  "version": "0.0.1-alpha",
  "description": "SCA4D 管理端框架无关 TypeScript 契约与客户端",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/openapi.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "api:generate": "openapi-typescript ${SCA4D_OPENAPI_URL:-http://localhost:8087/v3/api-docs} -o src/generated/openapi.ts"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "dayjs": "^1.11.13",
    "eventsource-client": "1.2.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.8.0",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
