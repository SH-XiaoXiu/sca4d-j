# 应用标题
VITE_APP_TITLE=Sca4d Server Admin

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=sca4d-server-admin-example

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=sca4d-server-admin-example-v1

# 使用 Hash 路由，构建产物不要求 Web Server 配置 SPA fallback
VITE_ROUTER_HISTORY=hash
