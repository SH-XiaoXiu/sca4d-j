# ------------------------------
# 运行环境与 HTTP
# ------------------------------
# Spring Profile；本地开发使用 local，部署环境按需使用 dev、test、staging 或 prod。
SPRING_PROFILES_ACTIVE=local
# 主应用对外显示名；部署后修改该值会改变日志、监控和服务注册中显示的应用名称。
SCA4DJ_APPLICATION_NAME=sca4d-j
# 主应用 HTTP 监听端口；取值范围为 1 至 65535。
SCA4DJ_SERVER_PORT=8080
# Servlet context path；根路径部署时留空，非空值必须以 / 开头。
SERVER_SERVLET_CONTEXT_PATH=
# 转发头处理策略；代理后部署使用 NATIVE，公网直连使用 NONE。
SERVER_FORWARD_HEADERS_STRATEGY=NATIVE
# Tomcat 可信代理地址正则；生产环境应收紧为实际 Gateway 或 Ingress 网段。
SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=10[.].*|192[.]168[.].*|127[.].*|::1
# 是否开放 OpenAPI 与 Swagger UI；生产环境应设为 false。
SCA4DJ_OPENAPI_ENABLED=true

# ------------------------------
# PostgreSQL 与 Flyway
# ------------------------------
# Compose 初始化数据库名；应与 JDBC URL 中的 database 一致。
SCA4DJ_DB_NAME=sca4dj
# JDBC 连接串；示例把连接会话时区固定为 Asia/Shanghai。
SCA4DJ_DB_URL=jdbc:postgresql://localhost:5432/sca4dj?options=-c%20TimeZone%3DAsia%2FShanghai
# PostgreSQL 登录用户；应只授予当前应用所需权限。
SCA4DJ_DB_USERNAME=sca4dj
# PostgreSQL 登录密码；生产环境必须替换并通过密钥系统注入。
SCA4DJ_DB_PASSWORD=sca4dj
# Compose 暴露 PostgreSQL 的宿主机地址与端口。
SCA4DJ_POSTGRES_BIND=127.0.0.1:5432
# PostgreSQL 服务默认时区；使用 IANA 时区名称。
SCA4DJ_DB_TIMEZONE=Asia/Shanghai
# 是否在主应用启动时执行 Flyway 校验与迁移。
SCA4DJ_FLYWAY_ENABLED=true

# ------------------------------
# Quartz 集群调度
# ------------------------------
# 全部 Server 节点共用的 Quartz schedulerName；同一数据库内必须保持一致。
SCA4DJ_SCHEDULER_NAME=sca4d-scheduler
# 当前 Server 节点的 Quartz 工作线程数；取值范围为 1 至 200。
SCA4DJ_SCHEDULER_THREAD_COUNT=10
# 集群节点签到间隔；使用正数 ISO-8601 Duration，范围为 1 秒至 5 分钟。
SCA4DJ_SCHEDULER_CLUSTER_CHECKIN_INTERVAL=PT15S
# misfire 判定阈值；使用正数 ISO-8601 Duration，范围为 1 秒至 24 小时。
SCA4DJ_SCHEDULER_MISFIRE_THRESHOLD=PT1M
# 应用关闭时等待运行中 Job 完成的最长时间；范围为 1 秒至 30 分钟。
SCA4DJ_SCHEDULER_SHUTDOWN_WAIT=PT30S
# 获取 PostgreSQL 会话级启动锁的总等待上限；范围为 1 秒至 10 分钟。
SCA4DJ_SCHEDULER_BOOTSTRAP_LOCK_TIMEOUT=PT30S
# 未取得启动锁时两次尝试之间的间隔；范围为 25 毫秒至 10 秒。
SCA4DJ_SCHEDULER_BOOTSTRAP_LOCK_RETRY_INTERVAL=PT0.25S

# ------------------------------
# Redis
# ------------------------------
# Redis 主机名或地址。
SCA4DJ_REDIS_HOST=localhost
# Redis TCP 端口；取值范围为 1 至 65535。
SCA4DJ_REDIS_PORT=6379
# Redis 密码；服务未启用密码时留空。
SCA4DJ_REDIS_PASSWORD=
# Compose 暴露 Redis 的宿主机地址与端口。
SCA4DJ_REDIS_BIND=127.0.0.1:6379

# 登录、注册、绑定、敏感操作确认和账号恢复的总有效期；必须是正数 ISO-8601 Duration。
SCA4DJ_AUTHENTICATION_TTL=PT10M
# 绑定认证请求与浏览器的 HttpOnly Cookie 名称；同一域名下的不同部署必须使用不同值。
SCA4DJ_AUTHENTICATION_BROWSER_COOKIE=sca4d_auth_browser
# 是否启用邮件验证码第二认证因素；启用前必须配置 Sender 和启用的对应模板。
SCA4DJ_AUTHENTICATION_EMAIL_CODE_ENABLED=false
# 邮件验证码 Challenge Redis key 前缀；同一 Redis 中的不同部署必须使用不同值。
SCA4DJ_AUTHENTICATION_EMAIL_CODE_KEY_PREFIX=sca4dj:authentication:email-code
# 单个邮件验证码有效期；必须是正数 ISO-8601 Duration。
SCA4DJ_AUTHENTICATION_EMAIL_CODE_TTL=PT5M
# 同一次认证两次邮件验证码投递的最短间隔；必须是正数 ISO-8601 Duration。
SCA4DJ_AUTHENTICATION_EMAIL_CODE_RESEND_INTERVAL=PT1M
# 单个邮件验证码最多允许的错误提交次数；取值范围为 1 至 20。
SCA4DJ_AUTHENTICATION_EMAIL_CODE_MAX_ATTEMPTS=5
# 发送认证邮件使用的启用 Sender 主键；邮件验证码关闭时留空。
SCA4DJ_AUTHENTICATION_EMAIL_CODE_SENDER_ID=
# 邮件验证码使用的启用模板 family。
SCA4DJ_AUTHENTICATION_EMAIL_CODE_TEMPLATE_FAMILY=authentication.email-code
# TOTP enrollment Redis key 前缀；同一 Redis 中的不同部署必须使用不同值。
SCA4DJ_AUTHENTICATION_TOTP_ENROLLMENT_KEY_PREFIX=sca4dj:authentication:totp-enrollment
# 身份验证器设置从创建到激活允许保留的时间；必须是正数 ISO-8601 Duration。
SCA4DJ_AUTHENTICATION_TOTP_ENROLLMENT_TTL=PT10M
# 身份验证器二维码显示的发行者名称；长度必须为 1 到 64 个字符。
SCA4DJ_AUTHENTICATION_TOTP_ISSUER=SCA4D
# 是否注册 Passkey 认证方式、WebAuthn RP 和对应 REST 资源。
SCA4DJ_AUTHENTICATION_PASSKEY_ENABLED=false
# Passkey registration Redis key 前缀；同一 Redis 中的不同部署必须使用不同值。
SCA4DJ_AUTHENTICATION_PASSKEY_REGISTRATION_KEY_PREFIX=sca4dj:authentication:passkey-registration
# Passkey assertion Redis key 前缀；必须与 registration 和其他部署前缀不同。
SCA4DJ_AUTHENTICATION_PASSKEY_ASSERTION_KEY_PREFIX=sca4dj:authentication:passkey-assertion
# Passkey registration 和 assertion 的有效期；必须是正数 ISO-8601 Duration。
SCA4DJ_AUTHENTICATION_PASSKEY_CEREMONY_TTL=PT5M
# WebAuthn RP ID；启用 Passkey 时必须配置为不含协议、端口和路径的应用域名。
SCA4DJ_AUTHENTICATION_PASSKEY_RP_ID=
# 浏览器和认证器显示的 WebAuthn RP 名称；长度必须为 1 到 64 个字符。
SCA4DJ_AUTHENTICATION_PASSKEY_RP_NAME=SCA4D
# 允许提交 WebAuthn 响应的精确 Origin，多个值使用英文逗号分隔；生产环境只接受 HTTPS。
SCA4DJ_AUTHENTICATION_PASSKEY_ORIGINS=

# ------------------------------
# 敏感信息加密
# ------------------------------
# 新密文写入的 key-id；轮换时先增加新密钥，再切换该值。
SCA4DJ_SECRET_KEYRING_ACTIVE_KEY_ID=local
# 本地开发使用的 32 字节 Base64 AES 密钥；生产环境必须替换，旧密钥仍有数据引用时不能移除。
SCA4DJ_SECRET_KEYRING_LOCAL_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# OIDC、OAuth2 和 LDAP 请求的连接等待上限。
SCA4DJ_IDENTITY_PROVIDER_CONNECTION_TIMEOUT=PT5S
# OIDC、OAuth2 和 LDAP 响应的读取等待上限。
SCA4DJ_IDENTITY_PROVIDER_READ_TIMEOUT=PT10S
# OIDC 授权请求 Redis key 前缀；同一 Redis 中的不同部署必须使用不同值。
SCA4DJ_IDENTITY_PROVIDER_OIDC_AUTHORIZATION_KEY_PREFIX=sca4dj:identity:oidc-authorization
# OIDC state、nonce 和 PKCE verifier 的保留时间；必须短于 Authentication 总有效期。
SCA4DJ_IDENTITY_PROVIDER_OIDC_AUTHORIZATION_TTL=PT5M
# 在外部 OpenID Provider 注册的精确后端 callback URI，例如 https://admin.example.com/api/auth/oidc/callback。
SCA4DJ_IDENTITY_PROVIDER_OIDC_REDIRECT_URI=
# callback 完成后返回管理端登录页的精确 URI，例如 https://admin.example.com/login。
SCA4DJ_IDENTITY_PROVIDER_OIDC_COMPLETION_URI=
# OAuth2 授权请求 Redis key 前缀；同一 Redis 中的不同部署必须使用不同值，且不能与 OIDC 前缀相同。
SCA4DJ_IDENTITY_PROVIDER_OAUTH2_AUTHORIZATION_KEY_PREFIX=sca4dj:identity:oauth2-authorization
# OAuth2 state 和 PKCE verifier 的保留时间；必须短于 Authentication 总有效期。
SCA4DJ_IDENTITY_PROVIDER_OAUTH2_AUTHORIZATION_TTL=PT5M
# 在外部 OAuth2 Provider 注册的精确后端 callback URI，例如 https://admin.example.com/api/auth/oauth2/callback。
SCA4DJ_IDENTITY_PROVIDER_OAUTH2_REDIRECT_URI=
# callback 完成后返回管理端登录页的精确 URI，例如 https://admin.example.com/login。
SCA4DJ_IDENTITY_PROVIDER_OAUTH2_COMPLETION_URI=
# 建立 SMTP 连接的最长等待时间。
SCA4DJ_MAIL_CONNECTION_TIMEOUT=PT5S
# SMTP 响应读取的最长等待时间。
SCA4DJ_MAIL_READ_TIMEOUT=PT10S
# SMTP 内容写入的最长等待时间。
SCA4DJ_MAIL_WRITE_TIMEOUT=PT10S
# Compose 暴露 Mailpit SMTP 的宿主机地址与端口。
SCA4DJ_MAILPIT_SMTP_BIND=127.0.0.1:1025
# Compose 暴露 Mailpit Web UI 的宿主机地址与端口。
SCA4DJ_MAILPIT_UI_BIND=127.0.0.1:8025

# ------------------------------
# RabbitMQ
# ------------------------------
# RabbitMQ 主机名或地址。
SCA4DJ_RABBITMQ_HOST=localhost
# RabbitMQ AMQP 端口；默认使用 5672。
SCA4DJ_RABBITMQ_PORT=5672
# RabbitMQ 登录用户；Compose 会用该值初始化账号。
SCA4DJ_RABBITMQ_USERNAME=sca4dj
# RabbitMQ 登录密码；生产环境必须替换。
SCA4DJ_RABBITMQ_PASSWORD=sca4dj
# RabbitMQ virtual host；默认使用根 vhost。
SCA4DJ_RABBITMQ_VHOST=/
# Compose 暴露 AMQP 的宿主机地址与端口。
SCA4DJ_RABBITMQ_AMQP_BIND=127.0.0.1:5672
# Compose 暴露 STOMP Relay 的宿主机地址与端口。
SCA4DJ_RABBITMQ_STOMP_BIND=127.0.0.1:61613
# Compose 暴露 RabbitMQ 管理后台的宿主机地址与端口。
SCA4DJ_RABBITMQ_MANAGEMENT_BIND=127.0.0.1:15672

# ------------------------------
# 首次管理员 Bootstrap
# ------------------------------
# 首个平台管理员的密码登录标识；留空时不执行创建。
SCA4DJ_BOOTSTRAP_PLATFORM_ADMINISTRATOR_IDENTIFIER=
# 首个平台管理员初始密码；留空时不执行创建，创建完成后应从环境移除。
SCA4DJ_BOOTSTRAP_PLATFORM_ADMINISTRATOR_PASSWORD=
# 首个平台管理员展示名称；.env 按 Java Properties 读取，非 ASCII 字符必须使用 Unicode 转义。
SCA4DJ_BOOTSTRAP_PLATFORM_ADMINISTRATOR_DISPLAY_NAME=\u5E73\u53F0\u7BA1\u7406\u5458

# ------------------------------
# 请求态与 IAM 清理
# ------------------------------
# 是否为每个 HTTP 请求创建 CurrentRequest；关闭后，依赖当前身份、语言或请求 ID 的代码无法读取这些信息。
SCA4DJ_REQUEST_CONTEXT_ENABLED=true
# CurrentRequestFilter 顺序；应早于认证与业务过滤器。
SCA4DJ_REQUEST_CONTEXT_FILTER_ORDER=-100
# Subject 关系清理调度间隔；使用 ISO-8601 Duration 且必须为正值。
SCA4DJ_IAM_CLEANUP_INTERVAL=PT1M

# ------------------------------
# MinIO 与文件上传、读取和后台清理
# ------------------------------
# 应用访问 MinIO 的服务端地址。
SCA4DJ_MINIO_ENDPOINT=http://localhost:9000
# 浏览器访问预签名对象的公开地址；反向代理部署时填写外部地址。
SCA4DJ_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# MinIO 访问账号；生产环境禁止使用默认账号。
SCA4DJ_MINIO_ACCESS_KEY=minioadmin
# MinIO 访问密钥；生产环境禁止使用默认密钥。
SCA4DJ_MINIO_SECRET_KEY=minioadmin
# 默认对象 Bucket 名称；应符合 S3 Bucket 命名规则。
SCA4DJ_MINIO_BUCKET=sca4dj
# Compose 暴露 MinIO API 的宿主机地址与端口。
SCA4DJ_MINIO_API_BIND=127.0.0.1:9000
# Compose 暴露 MinIO Console 的宿主机地址与端口。
SCA4DJ_MINIO_CONSOLE_BIND=127.0.0.1:9001
# 是否在应用启动时验证当前启用的 MinIO 依赖。
SCA4DJ_MINIO_STARTUP_CHECK_ENABLED=true
# MinIO 启动检查严重等级；可选 REQUIRED 或 OPTIONAL。
SCA4DJ_MINIO_STARTUP_CHECK_CRITICALITY=REQUIRED
# 单次 MinIO 启动检查超时；使用正数 ISO-8601 Duration。
SCA4DJ_MINIO_STARTUP_CHECK_TIMEOUT=PT3S
# 是否注册文件上传、访问和后台清理组件。
SCA4DJ_FILE_ENABLED=true
# 新文件存储实现；可选 MINIO 或 LOCAL。
SCA4DJ_FILE_STORAGE=MINIO
# 单文件上传上限；使用 Spring DataSize 格式。
SCA4DJ_FILE_MAX_SIZE=20MB
# 临时上传地址有效期；使用正数 ISO-8601 Duration。
SCA4DJ_FILE_UPLOAD_TTL=PT10M
# 已上传但未被业务消费文件的保留时间。
SCA4DJ_FILE_READY_TTL=PT24H
# 文件读取地址或授权有效期。
SCA4DJ_FILE_ACCESS_TTL=PT5M
# uploadGrant 有效期。
SCA4DJ_FILE_GRANT_TTL=PT24H
# 文件清理临时调度间隔；使用正数 ISO-8601 Duration。
SCA4DJ_FILE_CLEANUP_INTERVAL=PT10M
# 删除处理节点失联后的重领等待时间；使用正数 ISO-8601 Duration。
SCA4DJ_FILE_CLEANUP_LEASE=PT30M
# 单节点每轮最多扫描和抢占的文件数；必须为正整数。
SCA4DJ_FILE_CLEANUP_BATCH_SIZE=100
# uploadGrant 签名密钥；生产环境必须使用独立且不少于 32 字节的随机值。
SCA4DJ_FILE_GRANT_SECRET=0123456789abcdef0123456789abcdef
# LOCAL 存储实现的对象根目录；MINIO 模式不使用。
SCA4DJ_FILE_LOCAL_ROOT=./file-data

# ------------------------------
# 集群 ID
# ------------------------------
# Snowflake Worker ID；同一数据中心内每个实例必须唯一，取值范围为 0 至 31。
SCA4DJ_ID_WORKER_ID=1
# Snowflake Data Center ID；跨数据中心部署时规划唯一值，取值范围为 0 至 31。
SCA4DJ_ID_DATA_CENTER_ID=1

# ------------------------------
# 消息与 Outbox
# ------------------------------
# 是否启用 RabbitMQ 消息发送和健康检查；关闭后，消息不会发送到 Broker。
SCA4DJ_MESSAGING_ENABLED=true
# 消息来源标识；默认与应用名一致，同一 Broker 中的不同应用必须使用不同值。
SCA4DJ_MESSAGING_SOURCE=sca4d-j
# RabbitMQ publisher confirm 最长等待时间。
SCA4DJ_MESSAGING_RABBIT_CONFIRM_TIMEOUT=PT5S
# 是否使用 RabbitMQ delayed-message 插件；Broker 未安装该插件时必须保持 false。
SCA4DJ_MESSAGING_RABBIT_DELAYED_EXCHANGE_ENABLED=false
# 是否自动声明脚手架默认 exchange、queue、DLX 与 DLQ。
SCA4DJ_MESSAGING_RABBIT_DECLARE_DEFAULT_TOPOLOGY=true
# 默认业务事件 exchange 名称。
SCA4DJ_MESSAGING_RABBIT_DEFAULT_EXCHANGE=sca4dj.event
# 默认业务事件 queue 名称。
SCA4DJ_MESSAGING_RABBIT_DEFAULT_QUEUE=sca4dj.event.default
# 默认业务事件 routing key；# 表示 topic exchange 的全部路由。
SCA4DJ_MESSAGING_RABBIT_DEFAULT_ROUTING_KEY=#
# 默认 dead-letter exchange 名称。
SCA4DJ_MESSAGING_RABBIT_DLX=sca4dj.event.dlx
# 默认 dead-letter queue 名称。
SCA4DJ_MESSAGING_RABBIT_DLQ=sca4dj.event.dlq
# 默认 dead-letter routing key。
SCA4DJ_MESSAGING_RABBIT_DLK=dead
# 是否启用 Outbox 可靠投递调度。
SCA4DJ_MESSAGING_OUTBOX_ENABLED=true
# Outbox 临时调度轮询间隔。
SCA4DJ_MESSAGING_OUTBOX_POLL_INTERVAL=PT3S
# 单节点每轮最多领取的 Outbox 消息数；必须为正整数。
SCA4DJ_MESSAGING_OUTBOX_BATCH_SIZE=50
# 单条 Outbox 消息进入死信终态前的最大尝试次数。
SCA4DJ_MESSAGING_OUTBOX_MAX_ATTEMPTS=10
# Outbox 首次失败后的重试退避时间。
SCA4DJ_MESSAGING_OUTBOX_INITIAL_BACKOFF=PT5S
# Outbox 指数退避上限。
SCA4DJ_MESSAGING_OUTBOX_MAX_BACKOFF=PT5M
# Outbox SENDING 租约超时；节点中断后超过该值可被重新领取。
SCA4DJ_MESSAGING_OUTBOX_SENDING_TIMEOUT=PT5M

# ------------------------------
# 缓存
# ------------------------------
# 缓存 key 命名空间；多应用或多环境共享 Redis 时必须区分。
SCA4DJ_CACHE_KEY_PREFIX=sca4dj
# Redis 二级缓存默认 TTL。
SCA4DJ_CACHE_REDIS_TTL=PT30M
# 进程内一级缓存默认 TTL。
SCA4DJ_CACHE_LOCAL_TTL=PT5M
# 单个进程内缓存最多保留的条目数。
SCA4DJ_CACHE_LOCAL_MAXIMUM_SIZE=1000

# ------------------------------
# 审计与请求日志
# ------------------------------
# 是否启用声明式审计切面。
SCA4DJ_AUDIT_ENABLED=true
# 是否记录成功完成的受审计业务操作。
SCA4DJ_AUDIT_RECORD_SUCCESS=true
# 是否记录抛出异常的受审计业务操作。
SCA4DJ_AUDIT_RECORD_FAILURE=true
# 全局审计执行模式；可选 ASYNC 或 SYNC。
SCA4DJ_AUDIT_MODE=ASYNC
# 异步审计线程池的工作线程数；必须为正整数。
SCA4DJ_AUDIT_ASYNC_WORKER_COUNT=2
# 异步审计有界等待队列容量；必须为正整数。
SCA4DJ_AUDIT_ASYNC_QUEUE_CAPACITY=1024
# 应用关闭时等待审计任务完成的最长时间。
SCA4DJ_AUDIT_ASYNC_SHUTDOWN_AWAIT=PT10S
# 审计业务载荷最大字符数；非正数表示不截断。
SCA4DJ_AUDIT_MAX_PAYLOAD_LENGTH=64000
# 审计载荷敏感字段名片段；使用逗号分隔并按不区分大小写包含匹配。
SCA4DJ_AUDIT_SENSITIVE_FIELDS=password,token,secret,salt,authorization
# 错误码扫描附加基础包；多个包使用逗号分隔，留空只扫描应用根包。
SCA4DJ_ERROR_CODE_BASE_PACKAGES=
# 是否输出独立 HTTP 访问日志。
SCA4DJ_REQUEST_LOG_ENABLED=true
# 请求耗时达到该值时使用 WARN 级别记录。
SCA4DJ_REQUEST_LOG_SLOW_WARN_THRESHOLD=PT1S
# 请求耗时达到该值或响应状态不低于 500 时使用 ERROR 级别记录。
SCA4DJ_REQUEST_LOG_SLOW_ERROR_THRESHOLD=PT3S

# ------------------------------
# 分布式锁、限流与幂等
# ------------------------------
# 是否启用声明式 Redisson 分布式锁。
SCA4DJ_LOCK_ENABLED=true
# 分布式锁 Redis key 前缀；多应用共享 Redis 时必须区分。
SCA4DJ_LOCK_KEY_PREFIX=lock
# 获取分布式锁的最长等待时间；PT0S 表示不等待。
SCA4DJ_LOCK_WAIT_TIME=PT5S
# 分布式锁租约时长；PT0S 表示使用 Redisson watchdog 自动续租。
SCA4DJ_LOCK_LEASE_TIME=PT0S
# 是否启用 Redis Bucket4j 集群限流。
SCA4DJ_RATE_LIMIT_ENABLED=true
# 限流 Redis key 前缀；多应用共享 Redis 时必须区分。
SCA4DJ_RATE_LIMIT_KEY_PREFIX=rate-limit
# 未被注解覆盖时的令牌桶容量；必须为正整数。
SCA4DJ_RATE_LIMIT_CAPACITY=60
# 每个窗口补充的令牌数；必须为正整数。
SCA4DJ_RATE_LIMIT_REFILL_TOKENS=60
# 令牌补充窗口；使用正数 ISO-8601 Duration。
SCA4DJ_RATE_LIMIT_TIME_WINDOW=PT1M
# 令牌补满后继续保留 Redis Bucket 状态的时间。
SCA4DJ_RATE_LIMIT_KEEP_AFTER_REFILL=PT5M
# 是否启用 Redis 集群幂等保护。
SCA4DJ_IDEMPOTENCY_ENABLED=true
# 幂等记录 Redis key 前缀；多应用共享 Redis 时必须区分。
SCA4DJ_IDEMPOTENCY_KEY_PREFIX=idempotency
# 首次执行拥有幂等处理权的租约；必须覆盖业务最大预期执行时长。
SCA4DJ_IDEMPOTENCY_PROCESSING_TTL=PT5M
# 成功响应允许重放的保留时间。
SCA4DJ_IDEMPOTENCY_SUCCESS_TTL=PT24H
# 原请求仍在处理时返回客户端的建议重试等待时间。
SCA4DJ_IDEMPOTENCY_RETRY_AFTER=PT3S

# ------------------------------
# 实时通信
# ------------------------------
# 是否注册全部 WebSocket 与 SSE 连接、订阅和消息发送组件。
SCA4DJ_REALTIME_ENABLED=true
# 是否启用 WebSocket/STOMP 入口。
SCA4DJ_REALTIME_WS_ENABLED=true
# WebSocket 握手 endpoint；必须与前端连接地址一致。
SCA4DJ_REALTIME_WS_ENDPOINT=/realtime/ws
# 是否在 WebSocket endpoint 同时启用 SockJS 回退。
SCA4DJ_REALTIME_WS_SOCKJS_ENABLED=true
# WebSocket 允许的 Origin 模式；多个模式使用逗号分隔，生产环境应限制为管理端域名。
SCA4DJ_REALTIME_WS_ALLOWED_ORIGIN_PATTERNS=*
# STOMP 应用 destination 前缀；多个值使用逗号分隔。
SCA4DJ_REALTIME_WS_APPLICATION_DESTINATION_PREFIXES=/app
# STOMP Broker destination 前缀；多个值使用逗号分隔。
SCA4DJ_REALTIME_WS_BROKER_DESTINATION_PREFIXES=/topic,/queue
# STOMP 用户 destination 前缀。
SCA4DJ_REALTIME_WS_USER_DESTINATION_PREFIX=/user
# 集群 unresolved user destination 广播地址。
SCA4DJ_REALTIME_WS_USER_DESTINATION_BROADCAST=/topic/unresolved-user-destination
# 集群用户注册表广播地址。
SCA4DJ_REALTIME_WS_USER_REGISTRY_BROADCAST=/topic/simp-user-registry
# 是否通过 RabbitMQ STOMP Relay 转发 WebSocket 消息。
SCA4DJ_REALTIME_WS_BROKER_RELAY_ENABLED=true
# STOMP Relay 主机名或地址。
SCA4DJ_REALTIME_WS_BROKER_RELAY_HOST=localhost
# STOMP Relay TCP 端口。
SCA4DJ_REALTIME_WS_BROKER_RELAY_PORT=61613
# STOMP Relay 客户端会话登录名；默认与 RabbitMQ 用户一致。
SCA4DJ_REALTIME_WS_BROKER_RELAY_CLIENT_LOGIN=sca4dj
# STOMP Relay 客户端会话密码；默认与 RabbitMQ 密码一致。
SCA4DJ_REALTIME_WS_BROKER_RELAY_CLIENT_PASSCODE=sca4dj
# STOMP Relay 系统会话登录名；默认与 RabbitMQ 用户一致。
SCA4DJ_REALTIME_WS_BROKER_RELAY_SYSTEM_LOGIN=sca4dj
# STOMP Relay 系统会话密码；默认与 RabbitMQ 密码一致。
SCA4DJ_REALTIME_WS_BROKER_RELAY_SYSTEM_PASSCODE=sca4dj
# 是否启用 STOMP 帧级 Redis 集群限流。
SCA4DJ_REALTIME_WS_FRAME_RATE_LIMIT_ENABLED=true
# STOMP 帧级限流窗口。
SCA4DJ_REALTIME_WS_FRAME_RATE_LIMIT_WINDOW=PT10S
# 单连接每窗口允许的 CONNECT 帧数。
SCA4DJ_REALTIME_WS_CONNECT_CAPACITY=20
# 单连接每窗口允许的 SUBSCRIBE 帧数。
SCA4DJ_REALTIME_WS_SUBSCRIBE_CAPACITY=120
# 单连接每窗口允许的 SEND 帧数。
SCA4DJ_REALTIME_WS_SEND_CAPACITY=60
# 是否启用 SSE 连接与跨节点投递。
SCA4DJ_REALTIME_SSE_ENABLED=true
# SSE 跨节点广播 exchange 名称。
SCA4DJ_REALTIME_SSE_EXCHANGE=sca4dj.realtime.sse
# 单条 SSE 连接保持时间。
SCA4DJ_REALTIME_SSE_TIMEOUT=PT30M
# SSE 心跳发送间隔；应短于连接和代理空闲超时。
SCA4DJ_REALTIME_SSE_HEARTBEAT_INTERVAL=PT25S

# ------------------------------
# Sa-Token
# ------------------------------
# HTTP 认证 token 名称；前后端必须保持一致。
SCA4DJ_SA_TOKEN_NAME=Authorization
# token 总有效期，单位秒；-1 表示永不过期。
SCA4DJ_SA_TOKEN_TIMEOUT=2592000
# token 活跃超时，单位秒；-1 表示不启用活跃冻结。
SCA4DJ_SA_TOKEN_ACTIVE_TIMEOUT=-1
# 是否输出 Sa-Token 内部日志；生产环境通常保持 false。
SCA4DJ_SA_TOKEN_LOG=false

# ------------------------------
# 可选 Gateway
# ------------------------------
# Gateway 应用名；同一监控系统中的不同 Gateway 实例组必须使用不同值。
SCA4DJ_GATEWAY_APPLICATION_NAME=sca4d-gateway
# Gateway HTTP 监听端口。
SCA4DJ_GATEWAY_SERVER_PORT=8088
# Gateway 静态 upstream 配置文件路径；相对路径基于启动工作目录。
SCA4DJ_GATEWAY_UPSTREAMS_FILE=config/gateway-upstreams.yml
# Gateway upstream 文件轮询间隔，单位毫秒；必须为正整数。
SCA4DJ_GATEWAY_RELOAD_INTERVAL_MILLIS=5000
# Gateway upstream 主动健康检查间隔，单位毫秒；必须为正整数。
SCA4DJ_GATEWAY_HEALTH_INTERVAL_MILLIS=5000

# ------------------------------
# 管理端开发与验证
# ------------------------------
# Vite 开发代理的后端地址；只在 pnpm dev 时使用。
SCA4D_API_TARGET=http://localhost:8080
# OpenAPI 生成和漂移检查使用的文档地址。
SCA4D_OPENAPI_URL=http://localhost:8080/v3/api-docs
# 管理端生产构建使用的 API 根地址；同域反向代理时使用 /api。
VITE_API_BASE_URL=/api
# Playwright 使用的 Chrome/Chromium 可执行文件路径；按本机安装位置调整。
PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/google-chrome
# 是否保存全部 E2E 截图；on 表示保存，其他值只在失败时保存。
PLAYWRIGHT_SCREENSHOT=off
# 使用已经启动的管理端执行 E2E；留空时由 Playwright 构建并启动 4173 预览服务。
SCA4D_E2E_BASE_URL=
# 是否运行连接真实后端和虚拟认证器的 Passkey 验收。
SCA4D_REAL_PASSKEY=false
# 真实 Passkey 验收使用的后端根地址，不包含 /api。
SCA4D_REAL_API_URL=http://localhost:8091
# 真实邮件验证码验收使用的 Mailpit 根地址。
SCA4D_MAILPIT_URL=http://127.0.0.1:8025
