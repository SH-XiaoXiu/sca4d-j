<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sca4d.openapi.client.mapper.OpenApiClientMapper">
    <resultMap id="client" type="com.sca4d.openapi.client.OpenApiClient">
        <constructor>
            <arg column="client_id" javaType="String"/>
            <arg column="account_id" javaType="_long"/>
            <arg column="display_name" javaType="String"/>
            <arg column="status" javaType="com.sca4d.openapi.client.OpenApiClientStatus"/>
        </constructor>
    </resultMap>

    <insert id="insertClient">
        INSERT INTO openapi_client (client_id, account_id, display_name, status)
        VALUES (#{clientId}, #{accountId}, #{displayName}, #{status})
    </insert>

    <select id="selectClient" resultMap="client">
        SELECT client_id, account_id, display_name, status
        FROM openapi_client
        <where>
            <if test="clientId != null">client_id = #{clientId}</if>
            <if test="accountId != null">AND account_id = #{accountId}</if>
            <if test="clientId == null and accountId == null">FALSE</if>
        </where>
        <if test="forUpdate">FOR UPDATE</if>
    </select>

    <select id="selectOperations" resultType="com.sca4d.core.api.name.code.TreeCode">
        SELECT operation FROM openapi_client_operation
        WHERE client_id = #{clientId}
        <if test="operation != null">AND operation = #{operation,typeHandler=com.sca4d.core.spring.persistence.mybatis.TreeCodeTypeHandler$Colon}</if>
        ORDER BY operation
    </select>

    <delete id="deleteOperations">
        DELETE FROM openapi_client_operation WHERE client_id = #{clientId}
    </delete>

    <insert id="insertOperations">
        INSERT INTO openapi_client_operation (client_id, operation)
        VALUES
        <foreach collection="operations" item="operation" separator=",">
            (#{clientId}, #{operation,typeHandler=com.sca4d.core.spring.persistence.mybatis.TreeCodeTypeHandler$Colon})
        </foreach>
    </insert>

    <update id="updateStatus">
        UPDATE openapi_client
        <set><if test="status.set">status = #{status.value}</if></set>
        WHERE client_id = #{clientId}
    </update>
</mapper>
