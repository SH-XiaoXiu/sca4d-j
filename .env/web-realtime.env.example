# Web Realtime 节点传输；LOCAL 只支持单实例，RABBIT 支持跨实例投递。
SCA4D_WEB_REALTIME_NODE_TRANSPORT=LOCAL
# Web Realtime 连接租约续期间隔。
SCA4D_WEB_REALTIME_LEASE_RENEW_INTERVAL=PT30S
# Web Realtime 连接租约有效时间，必须长于续期间隔。
SCA4D_WEB_REALTIME_LEASE_DURATION=PT90S
# 单条 RabbitMQ 节点消息最多包含的 Connection 数。
SCA4D_WEB_REALTIME_ROUTING_BATCH_SIZE=500
# Web Realtime 节点临时消息 TTL。
SCA4D_WEB_REALTIME_NODE_MESSAGE_TTL=PT30S
# SSE 心跳间隔。
SCA4D_WEB_REALTIME_HEARTBEAT_INTERVAL=PT25S
# 单次 SSE 连接最长时间。
SCA4D_WEB_REALTIME_SSE_CONNECTION_TIMEOUT=PT30M
# 每个 SSE 连接的待写出消息容量。
SCA4D_WEB_REALTIME_CONNECTION_QUEUE_CAPACITY=64
# WebSocket 一次性票据有效时间。
SCA4D_WEB_REALTIME_TICKET_TTL=PT10S
# WebSocket 建立后等待 STOMP CONNECT 的时间。
SCA4D_WEB_REALTIME_STOMP_CONNECT_TIMEOUT=PT10S
# 单个 STOMP 入站帧的最大字节数。
SCA4D_WEB_REALTIME_INBOUND_FRAME_MAX_BYTES=65536
# 允许建立浏览器 WebSocket 的完整 Origin；多个值使用逗号分隔。
SCA4D_WEB_REALTIME_ALLOWED_ORIGINS=${SCA4D_FRONTEND_ORIGIN}
# Spring STOMP broker 模式；NODE_ROUTED 使用节点内 simple broker，BROKER_RELAY 使用 RabbitMQ STOMP plugin。
SCA4D_WEB_REALTIME_STOMP_MODE=NODE_ROUTED
# Spring STOMP WebSocket 单连接最大待发送字节数。
SCA4D_WEB_REALTIME_STOMP_SEND_BUFFER_MAX_BYTES=262144
# Spring STOMP 单次 WebSocket 写出最长时间。
SCA4D_WEB_REALTIME_STOMP_SEND_TIME_LIMIT=PT10S
# BROKER_RELAY 模式使用的 RabbitMQ STOMP plugin 地址和凭据。
SCA4D_WEB_REALTIME_STOMP_RELAY_HOST=localhost
SCA4D_WEB_REALTIME_STOMP_RELAY_PORT=61613
SCA4D_WEB_REALTIME_STOMP_RELAY_CLIENT_LOGIN=sca4dj
SCA4D_WEB_REALTIME_STOMP_RELAY_CLIENT_PASSCODE=sca4dj
SCA4D_WEB_REALTIME_STOMP_RELAY_SYSTEM_LOGIN=sca4dj
SCA4D_WEB_REALTIME_STOMP_RELAY_SYSTEM_PASSCODE=sca4dj
SCA4D_WEB_REALTIME_STOMP_RELAY_VIRTUAL_HOST=/
# BROKER_RELAY 模式启动时探测 RabbitMQ STOMP plugin TCP 端口的最长时间。
SCA4D_WEB_REALTIME_STOMP_RELAY_STARTUP_CONNECT_TIMEOUT=PT3S
