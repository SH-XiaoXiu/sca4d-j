# RabbitMQ AMQP 地址。
SCA4DJ_RABBITMQ_HOST=localhost
# RabbitMQ AMQP 端口。
SCA4DJ_RABBITMQ_PORT=5672
# RabbitMQ 本地开发账号；生产环境必须替换。
SCA4DJ_RABBITMQ_USERNAME=sca4dj
# RabbitMQ 本地开发密码；生产环境必须替换。
SCA4DJ_RABBITMQ_PASSWORD=sca4dj
# Compose 暴露 AMQP 的宿主机地址与端口。
SCA4DJ_RABBITMQ_AMQP_BIND=127.0.0.1:5672
# Compose 暴露管理界面的宿主机地址与端口。
SCA4DJ_RABBITMQ_MANAGEMENT_BIND=127.0.0.1:15672
# Compose 暴露 RabbitMQ STOMP plugin 的宿主机地址与端口；仅 BROKER_RELAY 模式使用。
SCA4DJ_RABBITMQ_STOMP_BIND=127.0.0.1:61613

# 等待 mandatory return 和 publisher confirm 的最长时间。
SCA4DJ_MESSAGING_CONFIRM_TIMEOUT=PT10S
# Outbox 派发扫描间隔。
SCA4DJ_MESSAGING_DISPATCH_INTERVAL=PT1S
# 每个实例每次最多领取的 Outbox 记录数。
SCA4DJ_MESSAGING_DISPATCH_BATCH_SIZE=100
# Outbox SENDING 状态租约时间。
SCA4DJ_MESSAGING_LEASE_DURATION=PT1M
# 第一次发布失败后的退避时间。
SCA4DJ_MESSAGING_INITIAL_BACKOFF=PT1S
# 持续发布失败时的最大退避时间。
SCA4DJ_MESSAGING_MAXIMUM_BACKOFF=PT5M
# RabbitMQ 已确认的 SENT 记录保留时间。
SCA4DJ_MESSAGING_SENT_RETENTION=P7D
# 相邻两次 SENT 历史清理的间隔。
SCA4DJ_MESSAGING_CLEANUP_INTERVAL=PT1H
# 每次最多删除的 SENT 记录数。
SCA4DJ_MESSAGING_CLEANUP_BATCH_SIZE=500
