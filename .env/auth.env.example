# Password 认证是否为 IAM bootstrap 账号初始化一次密码凭据。
SCA4D_AUTH_PASSWORD_BOOTSTRAP_ENABLED=true
# Password 登录允许解析的 Account 标识类型；Sca4d Server 默认支持用户名和邮箱。
SCA4D_AUTH_PASSWORD_LOGIN_IDENTIFIER_TYPES=USERNAME,EMAIL
# 初始管理员密码；该固定值只用于本地开发，生产环境必须替换。
SCA4D_AUTH_PASSWORD_BOOTSTRAP_PASSWORD=admin@123
# 服务端登录会话有效期，使用 ISO-8601 Duration。
SCA4D_AUTH_SESSION_TTL=P30D
# 普通 HTTP 请求默认使用的认证 Token；可选 SESSION 或 JWT。
SCA4D_AUTH_TOKEN_MODE=SESSION
# JWT 当前签名密钥的编号，必须对应 sca4dj.auth.jwt.keys 中的一个密钥。
SCA4D_AUTH_JWT_ACTIVE_KEY_ID=primary
# primary 对应的 HS256 密钥；该固定测试值只用于本地开发，生产环境必须替换。
SCA4D_AUTH_JWT_PRIMARY_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# JWT iss 声明；默认使用 spring.application.name，签发和验证必须使用相同值。
SCA4D_AUTH_JWT_ISSUER=sca4d-server
# JWT aud 声明；默认使用 spring.application.name，签发和验证必须使用相同值。
SCA4D_AUTH_JWT_AUDIENCE=sca4d-server
# JWT access Token 有效期，使用 ISO-8601 Duration。
SCA4D_AUTH_JWT_ACCESS_TTL=PT5M
# 接受和签发的 JWT 最大字符数，避免过大的 Header 和解析输入。
SCA4D_AUTH_JWT_MAX_TOKEN_LENGTH=6144
# Sa-Token 内部 Token 名称；HTTP 认证固定使用 Authorization Bearer。
SCA4D_AUTH_TOKEN_NAME=Authorization
# Sa-Token 默认有效期，单位为秒；实际登录 Session 由 SCA4D_AUTH_SESSION_TTL 覆盖。
SCA4D_SA_TOKEN_TIMEOUT=2592000
# 认证尝试状态的有效期，使用 ISO-8601 Duration。
SCA4D_AUTH_ENGINE_ATTEMPT_TTL=PT5M
# TOTP 注册流程的有效期，使用 ISO-8601 Duration。
SCA4D_AUTH_TOTP_ENROLLMENT_TTL=PT10M
# Passkey 依赖方 ID；本地 `localhost` 页面使用 `localhost`，不能填写端口。
SCA4D_AUTH_PASSKEY_RELYING_PARTY_ID=localhost
# 浏览器和认证器显示的 Passkey 依赖方名称。
SCA4D_AUTH_PASSKEY_RELYING_PARTY_NAME=Sca4d-J
# 能完成 WebAuthn ceremony 的浏览器完整 Origin；本地管理端默认监听 5666。
SCA4D_AUTH_PASSKEY_ORIGINS=${SCA4D_FRONTEND_ORIGIN}
