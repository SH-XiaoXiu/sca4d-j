# Compose 暴露 Mailpit SMTP 的本机地址；Sca4d Server 在宿主机运行时使用 localhost:1025。
SCA4DJ_MAILPIT_SMTP_BIND=127.0.0.1:1025
# Compose 暴露 Mailpit Web UI 的本机地址。
SCA4DJ_MAILPIT_UI_BIND=127.0.0.1:8025

# SMTP 建连、读取和写入超时，使用正数 ISO-8601 Duration。
SCA4DJ_NOTIFICATION_EMAIL_CONNECTION_TIMEOUT=PT5S
SCA4DJ_NOTIFICATION_EMAIL_READ_TIMEOUT=PT10S
SCA4DJ_NOTIFICATION_EMAIL_WRITE_TIMEOUT=PT10S
SCA4DJ_NOTIFICATION_EMAIL_MAX_ATTACHMENT_BYTES=20971520
