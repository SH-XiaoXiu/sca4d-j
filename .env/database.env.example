# PostgreSQL JDBC 地址。
SCA4DJ_DB_URL=jdbc:postgresql://localhost:5432/sca4dj?options=-c%20TimeZone%3DUTC
# PostgreSQL 数据库名称，供 Docker Compose 使用。
SCA4DJ_DB_NAME=sca4dj
# PostgreSQL 用户名。
SCA4DJ_DB_USERNAME=sca4dj
# PostgreSQL 密码。
SCA4DJ_DB_PASSWORD=sca4dj
# PostgreSQL 时区，供 Docker Compose 使用。
SCA4DJ_DB_TIMEZONE=Asia/Shanghai
# PostgreSQL 本机端口绑定。
SCA4DJ_POSTGRES_BIND=127.0.0.1:5432
# 单条 SQL 批次允许的最大条目数。
SCA4DJ_PERSISTENCE_BATCH_MAX_ITEMS=1000
# 单条 SQL 批次允许的最大绑定参数数量。
SCA4DJ_PERSISTENCE_BATCH_MAX_BIND_PARAMETERS=30000
