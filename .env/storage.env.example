# 新文件默认使用的存储实现标识；必须与已启用实现的 backend-id 一致。
SCA4DJ_STORAGE_BACKEND_DEFAULT=minio
# App 文件传输路由的浏览器可访问根地址，本地目录签名 URL 使用该地址。
SCA4DJ_STORAGE_TRANSFER_BASE_URL=${SCA4DJ_GATEWAY_ORIGIN}/api
# 上传签名 URL 有效期，使用正数 ISO-8601 Duration。
SCA4DJ_STORAGE_UPLOAD_TTL=PT10M
# 读取签名 URL 有效期，使用正数 ISO-8601 Duration。
SCA4DJ_STORAGE_ACCESS_TTL=PT5M
# 上传完成但尚未绑定业务的文件保留时间。
SCA4DJ_STORAGE_READY_RETENTION=PT24H
# 文件清理任务的固定延迟。
SCA4DJ_STORAGE_CLEANUP_INTERVAL=PT10M
# 删除任务被一个实例领取后的租约时间。
SCA4DJ_STORAGE_DELETE_LEASE=PT2M
# 对象删除失败后的再次领取间隔。
SCA4DJ_STORAGE_DELETE_RETRY_DELAY=PT10M
# 全局单文件最大精确字节数，默认 20 MiB。
SCA4DJ_STORAGE_MAX_SIZE_BYTES=20971520

# 是否注册本地目录存储；默认使用 MinIO 时关闭，需要切换或读取历史 Local 文件时启用。
SCA4DJ_STORAGE_LOCAL_ENABLED=false
# 本地目录存储写入文件记录的稳定实现标识。
SCA4DJ_STORAGE_LOCAL_BACKEND_ID=local
# 本地目录存储写入文件记录的命名空间。
SCA4DJ_STORAGE_LOCAL_CONTAINER=files
# 本地对象根目录；对象键由文件模块生成，不包含原文件名。
SCA4DJ_STORAGE_LOCAL_ROOT=docker-data/files

# 是否注册 MinIO 存储实现。
SCA4DJ_STORAGE_MINIO_ENABLED=true
# MinIO 写入文件记录的稳定实现标识。
SCA4DJ_STORAGE_MINIO_BACKEND_ID=minio
# App 访问 MinIO 的内部端点；App 在宿主机运行时使用 localhost。
SCA4DJ_STORAGE_MINIO_ENDPOINT=http://localhost:9000
# 浏览器访问预签名 URL 的公开 Origin，不包含 Bucket 或其他路径。
SCA4DJ_STORAGE_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# MinIO 签名和对象请求使用的 Region。
SCA4DJ_STORAGE_MINIO_REGION=us-east-1
# MinIO 本地开发访问账号；生产环境必须替换。
SCA4DJ_MINIO_ACCESS_KEY=minioadmin
# MinIO 本地开发访问密钥；生产环境必须替换。
SCA4DJ_MINIO_SECRET_KEY=minioadmin
# 保存文件对象的 Bucket；单域名反向代理时应为该 Bucket 配置同名路径。
SCA4DJ_STORAGE_MINIO_BUCKET=sca4dj
# 本地启动时是否自动创建缺失的 Bucket；生产环境可以关闭。
SCA4DJ_STORAGE_MINIO_CREATE_BUCKET=true

# Compose 暴露 MinIO API 的宿主机地址与端口。
SCA4DJ_MINIO_API_BIND=127.0.0.1:9000
# Compose 暴露 MinIO Console 的宿主机地址与端口。
SCA4DJ_MINIO_CONSOLE_BIND=127.0.0.1:9001
# 允许管理端直接请求预签名 URL 的 Origin；多个 Origin 按 MinIO 支持的格式填写。
SCA4DJ_MINIO_CORS_ALLOW_ORIGIN=${SCA4DJ_FRONTEND_ORIGIN}
