# Spring 运行环境，默认使用本地配置。
SPRING_PROFILES_ACTIVE=local
# 服务名称，用于日志和 OpenAPI。
SCA4D_APPLICATION_NAME=sca4d-server
# 页面、OpenAPI 与启动 Banner 使用的产品展示名称。
APP_PRODUCT_DISPLAY_NAME=Sca4d-J
# OpenAPI 与启动 Banner 使用的联系人名称。
APP_PRODUCT_CONTACT_NAME=XiaoXiu
# TOTP 认证器中显示的发行方名称。
APP_PRODUCT_TOTP_ISSUER=Sca4d-J
# HTTP 监听端口。
SCA4D_SERVER_PORT=8080
# 浏览器访问管理端时使用的完整 Origin；Passkey、Web Realtime 和 MinIO CORS 默认引用该值。
SCA4D_FRONTEND_ORIGIN=http://localhost:5666
# 浏览器访问 Gateway 时使用的完整 Origin；文件传输和联邦登录回调默认引用该值。
SCA4D_GATEWAY_ORIGIN=http://localhost:8088
# Gateway 监听端口。
SCA4D_GATEWAY_PORT=8088
# Server 是否在 readiness 后向 Gateway 注册；本地完整运行默认启用。
SCA4D_GATEWAY_REGISTRATION_ENABLED=true
# Server 调用 Gateway 控制 API 的基础地址。
SCA4D_GATEWAY_BASE_URL=http://localhost:8088
# Gateway 可以访问的当前 Server 实例基础地址。
SCA4D_SERVER_BASE_URL=http://localhost:8080
# 当前 Server 实例的唯一标识；多实例运行时必须分别设置。
SCA4D_INSTANCE_ID=sca4d-server-local-1
# Gateway 注册控制和可信转发使用的 Secret；生产环境必须替换。
SCA4D_GATEWAY_SECRET=local-gateway-secret-change-me
# 当前应用实例的雪花 ID 节点编号，集群内必须唯一，取值 0 至 1023。
SCA4D_ID_NODE_ID=0
# OpenAPI 与 Swagger UI 是否启用。
SCA4D_CORE_OPENAPI_ENABLED=true
# 分页查询默认每页数量。
SCA4D_CORE_PAGINATION_DEFAULT_SIZE=20
# 分页查询允许的最大每页数量。
SCA4D_CORE_PAGINATION_MAX_SIZE=200
# 是否检查需要正整数的 HTTP 输入。
SCA4D_CORE_HTTP_INPUT_VALIDATION_POSITIVE_INTEGER_ENABLED=true
# 是否在 Controller 调用前检查请求体约束。
SCA4D_CORE_HTTP_INPUT_VALIDATION_REQUEST_BODY_VALIDATION_ENABLED=true
# 是否限制 HTTP 字符串输入长度。
SCA4D_CORE_HTTP_INPUT_VALIDATION_STRING_SIZE_ENABLED=true
# HTTP 字符串输入允许的最大字符数。
SCA4D_CORE_HTTP_INPUT_VALIDATION_MAX_STRING_LENGTH=4096
# 是否限制 HTTP 容器输入的元素数量。
SCA4D_CORE_HTTP_INPUT_VALIDATION_CONTAINER_SIZE_ENABLED=true
# HTTP 容器输入允许的最大元素数量。
SCA4D_CORE_HTTP_INPUT_VALIDATION_MAX_CONTAINER_SIZE=1000
# 密钥环当前使用的密钥编号，默认选择本地开发密钥。
SCA4D_SECRET_KEYRING_ACTIVE_KEY_ID=local-dev
# 本地开发密钥，必须是 32 字节密钥的 Base64 编码；生产环境必须替换。
SCA4D_SECRET_KEYRING_LOCAL_DEV_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# 成功 Job run 从完成时间起保留多久。
SCA4D_JOB_SUCCEEDED_RETENTION=P30D
# 相邻两次成功 Job 历史清理的间隔。
SCA4D_JOB_HISTORY_CLEANUP_INTERVAL=PT1H
# 每次最多删除的成功 Job 根运行数。
SCA4D_JOB_HISTORY_CLEANUP_BATCH_SIZE=500
