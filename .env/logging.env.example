# Java 进程按 <root>/<service>/<instance>/application.json 写入 ECS JSON 日志。
SCA4D_LOG_ROOT=./logs
SCA4D_LOG_HOST=local-host
SCA4D_ENVIRONMENT=local

# Gateway 只开放经过独立 Basic Auth 的 Loki 写入路由。
SCA4D_GATEWAY_LOGGING_ENABLED=true
SCA4D_GATEWAY_LOKI_ORIGIN=http://127.0.0.1:3100
SCA4D_LOKI_PUSH_USERNAME=alloy
SCA4D_LOKI_PUSH_PASSWORD=local-loki-push-change-me

# 各地 Alloy 把日志发送到中心 Gateway 的 HTTPS 或可信内网地址。
SCA4D_ALLOY_HTTP_LISTEN_ADDR=127.0.0.1:12345
SCA4D_LOKI_PUSH_URL=http://127.0.0.1:8088/internal/logging/push

# 中心端 Grafana 与仅供同机 Gateway 使用的 Loki 回环端口。
SCA4D_GRAFANA_BIND=127.0.0.1:3000
SCA4D_GRAFANA_ADMIN_USERNAME=admin
SCA4D_GRAFANA_ADMIN_PASSWORD=local-grafana-admin-change-me
SCA4D_LOKI_BIND=127.0.0.1:3100

# filesystem 与 s3 二选一。切换不会迁移或合并另一种存储中的日志。
SCA4D_LOKI_STORAGE_MODE=filesystem
SCA4D_LOKI_RETENTION=720h
SCA4D_LOKI_S3_ENDPOINT=http://minio:9000
SCA4D_LOKI_S3_REGION=us-east-1
SCA4D_LOKI_S3_BUCKET=loki-logs
SCA4D_LOKI_S3_ACCESS_KEY=
SCA4D_LOKI_S3_SECRET_KEY=
SCA4D_LOKI_S3_INSECURE=true
