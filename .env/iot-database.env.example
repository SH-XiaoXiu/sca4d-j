# 是否启用独立 TimescaleDB、Flyway、Telemetry Sink 和历史清理。
SCA4DJ_IOT_TIMESCALE_ENABLED=true
# Sca4d Server 在宿主机运行时连接的 JDBC 地址。
SCA4DJ_IOT_TIMESCALE_URL=jdbc:postgresql://localhost:5433/sca4dj_iot?options=-c%20TimeZone%3DUTC
SCA4DJ_IOT_TIMESCALE_DB_NAME=sca4dj_iot
SCA4DJ_IOT_TIMESCALE_USERNAME=sca4dj
SCA4DJ_IOT_TIMESCALE_PASSWORD=sca4dj
SCA4DJ_IOT_TIMESCALE_TIMEZONE=Asia/Shanghai
SCA4DJ_IOT_TIMESCALE_BIND=127.0.0.1:5433

# Apache-only drop_chunks 调度和三类高频历史保留期。
SCA4DJ_IOT_TIMESCALE_CLEANUP_INTERVAL=PT1H
SCA4DJ_IOT_TELEMETRY_RETENTION=P90D
# 单次 Telemetry 高频历史查询允许返回的最大样本数。
SCA4DJ_IOT_TIMESCALE_MAX_QUERY_RESULTS=1000
