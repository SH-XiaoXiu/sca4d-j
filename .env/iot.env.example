# 是否启用 EMQX MQTT、HTTP Authenticator 回调和连接对账。
SCA4D_IOT_EMQX_ENABLED=true
# Sca4d Server 连接 EMQX 内部 MQTT listener 的地址与端口。
SCA4D_IOT_EMQX_HOST=localhost
SCA4D_IOT_EMQX_INTERNAL_MQTT_PORT=1884
SCA4D_IOT_EMQX_INTERNAL_MQTT_TLS=false
# 可选：未配置时，Sca4d Server 按 RuntimeNamespace 自动生成带 UUID 的实例 Client ID。
# 显式配置时，必须保证同时运行的实例之间不重复，例如：
# SCA4D_IOT_EMQX_CLIENT_ID=sca4d-server:sca4dj:iot:emqx:client:instance-1
# 本地内部 listener 只绑定宿主机；Server 使用固定 username 匹配只读系统 Topic ACL，不发送密码。
SCA4D_IOT_EMQX_SHARED_SUBSCRIPTION_GROUP=sca4dj-iot
SCA4D_IOT_EMQX_OPERATION_TIMEOUT=PT10S

# EMQX Management API。示例值只用于本机，其他环境必须分别替换 key 和 secret。
SCA4D_IOT_EMQX_MANAGEMENT_BASE_URL=http://localhost:18083
SCA4D_IOT_EMQX_MANAGEMENT_API_KEY=sca4dj-iot-local
SCA4D_IOT_EMQX_MANAGEMENT_SECRET=local-emqx-api-secret-change-me
SCA4D_IOT_EMQX_MANAGEMENT_PAGE_SIZE=100
SCA4D_IOT_EMQX_RECONCILIATION_INTERVAL=PT10M
# HTTP Authenticator 回调使用。示例值只用于本机。
SCA4D_IOT_EMQX_WEBHOOK_SECRET=local-emqx-webhook-secret-change-me

# Device Session 有效期读取 auth.env 中的 SCA4D_AUTH_SESSION_TTL。
# 连接投影和可靠任务参数。
SCA4D_IOT_CONNECTION_TTL=PT3M
SCA4D_IOT_ACKNOWLEDGEMENT_TIMEOUT=PT30S
# 公共模块内部目录扫描、定时触发和终态清理的单轮数量。
SCA4D_IOT_PRODUCT_CATALOG_SCAN_BATCH_SIZE=1000
SCA4D_IOT_DEVICE_SCHEDULE_BATCH_SIZE=1000
SCA4D_IOT_DOWNLINK_CLEANUP_BATCH_SIZE=10000

# Compose 只把本地开发端口绑定到 127.0.0.1。
SCA4D_IOT_EMQX_DEVICE_MQTT_BIND=127.0.0.1:1883
SCA4D_IOT_EMQX_INTERNAL_MQTT_BIND=127.0.0.1:1884
SCA4D_IOT_EMQX_DASHBOARD_BIND=127.0.0.1:18083
SCA4D_IOT_EMQX_DASHBOARD_PASSWORD=local-emqx-dashboard-change-me
