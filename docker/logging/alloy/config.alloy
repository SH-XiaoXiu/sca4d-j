local.file_match "applications" {
	path_targets = [
		{
			"__path__"    = "/var/log/applications/*/*/application.json",
			"environment" = sys.env("SCA4D_ENVIRONMENT"),
			"host"        = sys.env("SCA4D_LOG_HOST"),
		},
	]
	sync_period = "10s"
}

discovery.relabel "applications" {
	targets = local.file_match.applications.targets

	rule {
		source_labels = ["__path__"]
		regex         = "/var/log/applications/([^/]+)/[^/]+/application\\.json"
		replacement   = "$1"
		target_label  = "service"
	}

	rule {
		source_labels = ["__path__"]
		regex         = "/var/log/applications/[^/]+/([^/]+)/application\\.json"
		replacement   = "$1"
		target_label  = "instance"
	}
}

loki.source.file "applications" {
	targets       = discovery.relabel.applications.output
	tail_from_end = true
	forward_to    = [loki.process.ecs.receiver]
}

loki.process "ecs" {
	forward_to = [loki.write.central.receiver]

	stage.json {
		expressions = {
			timestamp = "\"@timestamp\"",
		}
	}

	stage.timestamp {
		source            = "timestamp"
		format            = "RFC3339Nano"
		action_on_failure = "skip"
	}

	stage.label_drop {
		values = ["filename"]
	}
}

loki.write "central" {
	endpoint {
		url = sys.env("SCA4D_LOKI_PUSH_URL")

		basic_auth {
			username = sys.env("SCA4D_LOKI_PUSH_USERNAME")
			password = sys.env("SCA4D_LOKI_PUSH_PASSWORD")
		}
	}
}
